<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>FlatXlsx</Title>
    <Version>1.0.0</Version>
    <Authors>Hideyuki Kitao</Authors>
    <Company />
    <LangVersion>latest</LangVersion>
    <Description>FlatXlsx converts object into Excel file</Description>
    <PackageProjectUrl>https://github.com/panda728/FlatXlsx</PackageProjectUrl>
    <Copyright>Copyright (c) Hideyuki Kitao 2022-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/panda728/FlatXlsx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'netstandard2.0' or $(TargetFramework) == 'netstandard2.1'">
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Serializers\PrimitiveSerializers.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>PrimitiveSerializers.cs</LastGenOutput>
    </None>
    <None Update="Serializers\TupleSerializers.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TupleSerializers.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Serializers\PrimitiveSerializers.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PrimitiveSerializers.tt</DependentUpon>
    </Compile>
    <Compile Update="Serializers\TupleSerializers.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TupleSerializers.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
