<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>FlatXlsx</Title>
    <Version>1.1.1</Version>
    <PackageReleaseNotes>License compliance: the package now carries THIRD-PARTY-NOTICES.txt, reproducing the MIT license and copyright notice of Cysharp/WebSerializer, from which the serialization pipeline is derived. No code or API changes.</PackageReleaseNotes>
    <Authors>Hideyuki Kitao</Authors>
    <Company />
    <LangVersion>latest</LangVersion>
    <Description>FlatXlsx converts objects into Excel (.xlsx) files - a fast, low-allocation streaming serializer for netstandard2.0 through .NET 10.</Description>
    <PackageProjectUrl>https://github.com/panda728/FlatXlsx</PackageProjectUrl>
    <Copyright>Copyright (c) Hideyuki Kitao 2022-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/panda728/FlatXlsx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>excel;xlsx;serializer;export;openxml;spreadsheetml;spreadsheet;fast;low-allocation;streaming</PackageTags>
    <!-- Messages in the main assembly are English; translations ship as satellite assemblies.
         Declaring this lets the runtime skip probing for one on an English system. -->
    <NeutralLanguage>en</NeutralLanguage>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Ship the XML docs so consumers get IntelliSense; CS1591 stays off because not every
         public member carries one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Debug symbols ship separately to nuget.org's symbol server. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- MIT requires the notices of the code this library derives from to travel with it,
         so they ship inside the package as well as living in the repository. -->
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Dependencies are Microsoft BCL packages only; no third-party libraries.
       System.IO.Pipelines: PipeWriter for ToPipeWriterAsync (not in-box for class libraries).
       System.Memory: Span/IBufferWriter on .NET Framework-era targets. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Serializers\PrimitiveSerializers.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>PrimitiveSerializers.cs</LastGenOutput>
    </None>
    <None Update="Serializers\TupleSerializers.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TupleSerializers.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Serializers\PrimitiveSerializers.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PrimitiveSerializers.tt</DependentUpon>
    </Compile>
    <Compile Update="Serializers\TupleSerializers.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TupleSerializers.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
